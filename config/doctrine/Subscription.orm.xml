<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Webgriffe\SyliusBackInStockNotificationPlugin\Entity\Subscription"
                       table="webgriffe_back_in_stock_notification_subscription">

        <indexes>
            <index name="idx_bisn_product_status_created" columns="product_id,status,created_at"/>
            <index name="idx_bisn_email_canonical" columns="email_canonical"/>
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <field name="hash" type="string" column="hash" unique="true"/>

        <field name="email" type="string" column="email"/>

        <field name="localeCode" type="string" column="local_code"/>

        <field name="createdAt" column="created_at" type="datetime">
            <gedmo:timestampable on="create"/>
        </field>
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>

        <field name="emailCanonical" type="string" column="email_canonical"/>

        <field name="name" type="string" column="name" nullable="true"/>

        <field name="status" type="string" column="status" length="16"/>

        <field name="notifiedAt" column="notified_at" type="datetime_immutable" nullable="true"/>

        <field name="holdUntil" column="hold_until" type="datetime_immutable" nullable="true"/>

        <field name="fulfilledAt" column="fulfilled_at" type="datetime_immutable" nullable="true"/>

        <field name="cancelledAt" column="cancelled_at" type="datetime_immutable" nullable="true"/>

        <field name="dismissedAt" column="dismissed_at" type="datetime_immutable" nullable="true"/>

        <many-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-column name="customer_id"/>
        </many-to-one>

        <many-to-one field="product" target-entity="Sylius\Component\Core\Model\ProductInterface">
            <join-column name="product_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="productVariant" target-entity="Sylius\Component\Core\Model\ProductVariantInterface">
            <join-column name="product_variant_id" nullable="true" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="heldVariant" target-entity="Sylius\Component\Core\Model\ProductVariantInterface">
            <join-column name="held_variant_id" nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" nullable="false"/>
        </many-to-one>

    </mapped-superclass>

</doctrine-mapping>
