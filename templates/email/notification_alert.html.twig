{% extends '@SyliusShop/email/layout.html.twig' %}

{% block subject %}{{ 'webgriffe_bisn.alert_email.alert_title'|trans({}, null, localeCode) }}{% endblock %}

{% block content %}
    {% set translation = product.translation(localeCode) %}
    <div style="text-align: center; padding-bottom: 30px;">
        <div style="font-size: 30px; line-height: 1.2;">
            {{ 'webgriffe_bisn.alert_email.alert_title'|trans({}, null, localeCode) }}
        </div>
    </div>

    <div style="text-align: center; padding-bottom: 15px; font-size: 15px;">
        {{ 'webgriffe_bisn.alert_email.alert_message'|trans({
            '{product}': translation.name
        }, null, localeCode) }}
    </div>

    <div style="text-align: center; padding-bottom: 15px; font-size: 15px;">
        {% if holdUntil is defined and holdUntil is not null %}
            {{ 'webgriffe_bisn.alert_email.held_until'|trans({'{until}': holdUntil|date('Y-m-d H:i')}, null, localeCode) }}
        {% elseif mode is defined and mode == 'fastest' %}
            {{ 'webgriffe_bisn.alert_email.fastest'|trans({}, null, localeCode) }}
        {% endif %}
    </div>

    <div style="text-align: center; padding-bottom: 30px; font-size: 15px;">
        <a href="{{ claimUrl ?? url('sylius_shop_product_show', {'slug': translation.slug, '_locale': localeCode}) }}" style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; text-transform: uppercase; border-radius: 3px;" target="_blank">
            {{ 'webgriffe_bisn.alert_email.alert_action'|trans({}, null, localeCode) }}
        </a>
    </div>

    {% if holdUntil is defined and holdUntil is not null %}
        <div style="text-align: center; padding-bottom: 30px; font-size: 13px; color: #666;">
            {{ 'webgriffe_bisn.alert_email.claim_hint'|trans({}, null, localeCode) }}
        </div>
    {% endif %}
{% endblock %}
