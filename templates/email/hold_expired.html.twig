{% extends '@SyliusShop/email/layout.html.twig' %}

{% block subject %}{{ 'webgriffe_bisn.hold_expired_mail.title'|trans({}, null, localeCode) }}{% endblock %}

{% block content %}
    {% set translation = product.translation(localeCode) %}
    <div style="text-align: center; padding-bottom: 30px;">
        <div style="font-size: 30px; line-height: 1.2;">
            {{ 'webgriffe_bisn.hold_expired_mail.title'|trans({}, null, localeCode) }}
        </div>
    </div>

    <div style="text-align: center; padding-bottom: 15px; font-size: 15px;">
        {{ 'webgriffe_bisn.hold_expired_mail.message'|trans({'{product}': translation.name}, null, localeCode) }}
    </div>

    {% if sellable %}
        <div style="text-align: center; padding-bottom: 15px; font-size: 15px;">
            {{ 'webgriffe_bisn.hold_expired_mail.still_available'|trans({}, null, localeCode) }}
        </div>

        <div style="text-align: center; padding-bottom: 30px; font-size: 15px;">
            <a href="{{ url('sylius_shop_product_show', {'slug': translation.slug, '_locale': localeCode}) }}" style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; text-transform: uppercase; border-radius: 3px;" target="_blank">
                {{ 'webgriffe_bisn.hold_expired_mail.buy_action'|trans({}, null, localeCode) }}
            </a>
        </div>
    {% else %}
        <div style="text-align: center; padding-bottom: 30px; font-size: 15px;">
            {{ 'webgriffe_bisn.hold_expired_mail.not_available'|trans({}, null, localeCode) }}
        </div>
    {% endif %}
{% endblock %}
